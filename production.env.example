# Public DNS names pointing to the server that runs Docker Compose.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
DATA_FORMULATOR_DOMAIN=data.example.com
PRESENTON_DOMAIN=slides.example.com
CADDY_EMAIL=ops@example.com
PRESENTON_CODEX_AUTH_PORT=1455

# Optional resource limits for generated cleaning containers.
CLEANING_SANDBOX_MEMORY_MB=512
CLEANING_SANDBOX_CPU_LIMIT=1
