# Google AI Studio / Gemini API Configuration
# Multi-key (recommended)
GEMINI_API_KEYS=key1,key2,key3

# Legacy single-key fallback (optional)
# GEMINI_API_KEY=key1

# Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Key cooldown (seconds)
GEMINI_KEY_COOLDOWN_SECONDS=30

# Comma-separated browser origins allowed to call the API and manage settings.
# For a public deployment, replace localhost with your HTTPS frontend domain.
INSIGHTFLOW_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stage 1 technical validation: maximum uploaded size in MiB.
MAX_FILE_SIZE_MB=50

# Generated cleaning; Docker Desktop must be running with Linux containers.
CLEANING_MAX_CODE_ATTEMPTS=3
CLEANING_APPROVAL_MODE=auto_safe
CLEANING_SANDBOX_BACKEND=docker
CLEANING_SANDBOX_IMAGE=cleaning-sandbox:1
CLEANING_CODE_TIMEOUT_SECONDS=30
CLEANING_SANDBOX_MEMORY_MB=512
CLEANING_SANDBOX_CPU_LIMIT=1

# Optional managed Google sandbox (requires google-cloud-aiplatform + ADC).
GCP_SANDBOX_RESOURCE_NAME=
GCP_AGENT_ENGINE_RESOURCE_NAME=

# Word Report Extractor / Presentation Agent
MAX_DOCX_SIZE_MB=25
MAX_UNCOMPRESSED_SIZE_MB=250
MAX_ZIP_ENTRIES=10000
# Optional override; defaults to backend/storage/report_jobs
# STORAGE_DIR=
